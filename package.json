{
  "name": "devmentor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "dev": "npm run dev -w @devmentor/app --",
    "build": "npm run build -w @devmentor/app --",
    "start": "npm run start -w @devmentor/app --",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "test": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "npm run test:e2e -w @devmentor/app --",
    "app:ephemeral": "node --import tsx test/integration/ephemeral-app.ts",
    "db:migrate": "npm run db:migrate -w @devmentor/db --",
    "db:migration:create": "npm run db:migration:create -w @devmentor/db --",
    "db:migration:list": "npm run db:migration:list -w @devmentor/db --",
    "db:migration:pending": "npm run db:migration:pending -w @devmentor/db --",
    "db:user:promote": "npm run db:user:promote -w @devmentor/db --",
    "audit": "npm audit --omit=dev --audit-level=high"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "agent-browser": "^0.39.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
